<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="400.0" prefWidth="600.0" styleClass="fundo-inicio" stylesheets="@../estilo.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.controllers.profControllers.PreviewFormularioController">
   <left>
      <fx:include source="BarraLateralProf.fxml" />
   </left>
   <center>
      <StackPane minHeight="0.0" minWidth="0.0">
         <children>
            <VBox alignment="CENTER" maxHeight="-Infinity" maxWidth="-Infinity" prefHeight="402.0" prefWidth="459.0">
               <children>
                  <Label text="Demonstração do Formulário">
                     <font>
                        <Font name="System Bold" size="24.0" />
                     </font>
                  </Label>
                  <ScrollPane fitToHeight="true" fitToWidth="true" prefHeight="362.0" prefWidth="459.0">
                     <content>
                        <VBox fx:id="vb_formulario" alignment="CENTER_LEFT" prefWidth="450.0" spacing="10.0">
                           <padding>
                              <Insets right="100.0" />
                           </padding></VBox>
                     </content>
                  </ScrollPane>
                  <HBox alignment="CENTER" prefHeight="90.0" prefWidth="459.0" spacing="20.0">
                     <children>
                        <Button fx:id="btn_voltar" lineSpacing="10.0" mnemonicParsing="false" onAction="#VoltarLista" prefHeight="40.0" prefWidth="120.0" style="-fx-background-radius: 8px;" text="Voltar">
                           <font>
                              <Font size="16.0" />
                           </font>
                        </Button>
                     </children>
                     <VBox.margin>
                        <Insets top="20.0" />
                     </VBox.margin>
                  </HBox>
               </children>
            </VBox>
         </children>
      </StackPane>
   </center>
</BorderPane>
