                  <Button fx:id="btn_cadastro_prof" maxHeight="-Infinity" maxWidth="-Infinity" mnemonicParsing="false" onAction="#cad_prof" prefHeight="26.0" prefWidth="150.0" style="-fx-background-radius: 8px; -fx-background-color: #4A7C59;" text="Cadastrar" textFill="WHITE">
