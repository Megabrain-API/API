<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="400.0" prefWidth="600.0" styleClass="fundo-inicio" stylesheets="@../estilo.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.controllers.profControllers.RespostaAlunoProfessorController">
   <left>
      <fx:include source="BarraLateralProf.fxml" />
   </left>
   <center>
      <StackPane minHeight="0.0" minWidth="0.0">
         <children>
            <VBox alignment="CENTER" maxHeight="-Infinity" maxWidth="-Infinity" prefHeight="535.0" prefWidth="720.0" spacing="7.0">
               <children>
                  <Label fx:id="lbl_titulo_correcao" text="Prova respondida" textFill="#1B1B1B" wrapText="true">
                     <font>
                        <Font name="System Bold" size="24.0" />
                     </font>
                  </Label>
                  <Label fx:id="lbl_info_correcao" alignment="CENTER" maxWidth="680.0" textFill="#444444" wrapText="true">
                     <font>
                        <Font size="12.0" />
                     </font>
                  </Label>
                  <Label fx:id="lbl_resumo_nota" alignment="CENTER" maxWidth="680.0" style="-fx-background-color: rgba(255,255,255,0.94); -fx-background-radius: 8px; -fx-padding: 6px 14px;" text="Pontuação: 0,00 / 0,00 pts" textFill="#1B1B1B" wrapText="true">
                     <font>
                        <Font name="System Bold" size="13.0" />
                     </font>
                  </Label>
                  <ScrollPane fitToHeight="true" fitToWidth="true" prefHeight="375.0" prefWidth="680.0">
                     <content>
                        <VBox fx:id="vb_respostas_professor" fillWidth="true" prefWidth="650.0" spacing="14.0">
                           <padding>
                              <Insets bottom="18.0" left="18.0" right="18.0" top="18.0" />
                           </padding>
                        </VBox>
                     </content>
                  </ScrollPane>
                  <HBox alignment="CENTER" prefHeight="55.0" prefWidth="680.0" spacing="16.0">
                     <children>
                        <Button mnemonicParsing="false" onAction="#voltarParaTurmas" prefHeight="40.0" prefWidth="160.0" style="-fx-background-radius: 8px;" text="Voltar aos alunos">
                           <font>
                              <Font size="14.0" />
                           </font>
                        </Button>
                        <Button fx:id="btn_salvar_correcao" mnemonicParsing="false" onAction="#salvarERetornarCorrecao" prefHeight="40.0" prefWidth="255.0" style="-fx-background-color: #4A7C59; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8px; -fx-cursor: hand;" text="Salvar e Retornar Prova Corrigida">
                           <font>
                              <Font size="14.0" />
                           </font>
                        </Button>
                     </children>
                  </HBox>
               </children>
            </VBox>
         </children>
      </StackPane>
   </center>
</BorderPane>