<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="600.0" prefWidth="960.0" styleClass="fundo-inicio" stylesheets="@../estilo.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.controllers.profControllers.TurmasProfessorController">
   <left>
      <fx:include source="BarraLateralProf.fxml" />
   </left>
   <center>
      <VBox prefHeight="600.0" prefWidth="880.0" spacing="0.0" BorderPane.alignment="CENTER">
         <children>
            <!-- Cabeçalho superior alinhado ao padrão MeuCursoAluno -->
            <HBox alignment="CENTER_LEFT" spacing="16.0" style="-fx-background-color: rgba(255, 255, 255, 0.90); -fx-border-color: #DCE5DF; -fx-border-width: 0 0 1 0;">
               <padding>
                  <Insets bottom="18.0" left="28.0" right="28.0" top="18.0" />
               </padding>
               <children>
                  <VBox spacing="4.0">
                     <children>
                        <Label fx:id="lbl_subtitulo_topo" text="MINHAS TURMAS" textFill="#4A7C59">
                           <font>
                              <Font name="System Bold" size="11.0" />
                           </font>
                        </Label>
                        <Label fx:id="lbl_titulo_turmas" text="Disciplinas e Cursos" textFill="#1B1B1B">
                           <font>
                              <Font name="System Bold" size="22.0" />
                           </font>
                        </Label>
                        <Label fx:id="lbl_caminho_turmas" text="Carregando disciplinas e cursos..." textFill="#5F6368" wrapText="true">
                           <font>
                              <Font size="13.0" />
                           </font>
                        </Label>
                     </children>
                  </VBox>
                  <Region HBox.hgrow="ALWAYS" />
                  <Button fx:id="btn_voltar_turmas" mnemonicParsing="false" onAction="#voltar" prefHeight="38.0" prefWidth="115.0" style="-fx-background-color: #F1F4F2; -fx-border-color: #C4D0C8; -fx-border-radius: 8px; -fx-background-radius: 8px; -fx-text-fill: #2B362F; -fx-font-weight: bold; -fx-cursor: hand;" text="Voltar" />
               </children>
            </HBox>

            <!-- Área rolável com os cards -->
            <ScrollPane fitToWidth="true" hbarPolicy="NEVER" style="-fx-background-color: transparent; -fx-background: transparent; -fx-border-color: transparent;" VBox.vgrow="ALWAYS">
               <content>
                  <VBox fx:id="vb_turmas_container" fillWidth="true" spacing="18.0">
                     <padding>
                        <Insets bottom="26.0" left="28.0" right="28.0" top="22.0" />
                     </padding>
                  </VBox>
               </content>
            </ScrollPane>
         </children>
      </VBox>
   </center>
</BorderPane>