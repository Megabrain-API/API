<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="650.0" prefWidth="980.0" styleClass="fundo-inicio" stylesheets="@../estilo.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.controllers.profControllers.BancoQuestoesController">
    <left>
        <fx:include source="BarraLateralProf.fxml" />
    </left>
    <center>
        <VBox prefHeight="650.0" prefWidth="880.0" spacing="0.0" BorderPane.alignment="CENTER">
            <children>
                <!-- Cabeçalho superior padronizado com filtros e botão + Criar Questão -->
                <VBox spacing="14.0" style="-fx-background-color: rgba(255, 255, 255, 0.94); -fx-border-color: #DCE5DF; -fx-border-width: 0 0 1 0;">
                    <padding>
                        <Insets bottom="16.0" left="28.0" right="28.0" top="18.0" />
                    </padding>
                    <children>
                        <HBox alignment="CENTER_LEFT" spacing="12.0">
                            <children>
                                <VBox spacing="4.0">
                                    <children>
                                        <Label fx:id="lbl_subtitulo_topo" text="REPOSITÓRIO DO PROFESSOR" textFill="#4A7C59">
                                            <font>
                                                <Font name="System Bold" size="11.0" />
                                            </font>
                                        </Label>
                                        <Label text="Banco de Questões" textFill="#1B1B1B">
                                            <font>
                                                <Font name="System Bold" size="22.0" />
                                            </font>
                                        </Label>
                                        <Label fx:id="lbl_total_questoes" text="0 questões" textFill="#5F6368">
                                            <font>
                                                <Font size="13.0" />
                                            </font>
                                        </Label>
                                    </children>
                                </VBox>
                                <Region HBox.hgrow="ALWAYS" />
                                <Button fx:id="btn_voltar_topo" mnemonicParsing="false" onAction="#voltarOrigem" prefHeight="38.0" prefWidth="110.0" style="-fx-background-color: #F1F4F2; -fx-border-color: #C4D0C8; -fx-border-radius: 8px; -fx-background-radius: 8px; -fx-text-fill: #2B362F; -fx-font-weight: bold; -fx-cursor: hand;" text="Voltar" />
                                <Button fx:id="btn_nova_questao" mnemonicParsing="false" onAction="#abrirModalNovaQuestao" prefHeight="38.0" prefWidth="155.0" style="-fx-background-color: #4A7C59; -fx-background-radius: 8px; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;" text="+ Criar Questão" />
                            </children>
                        </HBox>

                        <!-- Barra de filtros: Enunciado, Disciplina e Tipo -->
                        <HBox alignment="CENTER_LEFT" spacing="12.0">
                            <children>
                                <TextField fx:id="txt_filtro_enunciado" prefHeight="38.0" promptText="Buscar questão pelo enunciado..." style="-fx-background-color: #FFFFFF; -fx-border-color: #C4D6CA; -fx-border-radius: 8px; -fx-background-radius: 8px; -fx-padding: 0 12 0 12; -fx-font-size: 13px;" HBox.hgrow="ALWAYS" />
                                <ComboBox fx:id="cb_filtro_disciplina" prefHeight="38.0" prefWidth="220.0" promptText="Todas as disciplinas" style="-fx-background-color: #FFFFFF; -fx-border-color: #C4D6CA; -fx-border-radius: 8px; -fx-background-radius: 8px; -fx-font-size: 13px;" />
                                <ComboBox fx:id="cb_filtro_tipo" prefHeight="38.0" prefWidth="190.0" promptText="Todos os tipos" style="-fx-background-color: #FFFFFF; -fx-border-color: #C4D6CA; -fx-border-radius: 8px; -fx-background-radius: 8px; -fx-font-size: 13px;" />
                            </children>
                        </HBox>
                    </children>
                </VBox>

                <!-- Área rolável com os cards das questões -->
                <ScrollPane fitToWidth="true" hbarPolicy="NEVER" style="-fx-background-color: transparent; -fx-background: transparent; -fx-border-color: transparent;" VBox.vgrow="ALWAYS">
                    <content>
                        <VBox fx:id="vbox_questoes_banco" fillWidth="true" spacing="14.0">
                            <padding>
                                <Insets bottom="26.0" left="28.0" right="28.0" top="22.0" />
                            </padding>
                        </VBox>
                    </content>
                </ScrollPane>

                <!-- Rodapé fixo exibido quando aberto a partir da Montagem da Prova -->
                <HBox fx:id="rodape_selecao" alignment="CENTER_LEFT" spacing="14.0" style="-fx-background-color: rgba(255, 255, 255, 0.94); -fx-border-color: #DCE5DF; -fx-border-width: 1 0 0 0;">
                    <padding>
                        <Insets bottom="14.0" left="28.0" right="28.0" top="14.0" />
                    </padding>
                    <children>
                        <Label fx:id="lbl_selecionadas_banco" text="0 selecionada(s)" textFill="#285A36">
                            <font>
                                <Font name="System Bold" size="13.0" />
                            </font>
                        </Label>
                        <Region HBox.hgrow="ALWAYS" />
                        <Button mnemonicParsing="false" onAction="#voltarOrigem" prefHeight="38.0" prefWidth="120.0" style="-fx-background-color: #F1F4F2; -fx-border-color: #C4D0C8; -fx-border-radius: 8px; -fx-background-radius: 8px; -fx-text-fill: #2B362F; -fx-font-weight: bold; -fx-cursor: hand;" text="Cancelar" />
                        <Button fx:id="btn_levar_questoes" mnemonicParsing="false" onAction="#levarQuestoesParaEditor" prefHeight="38.0" prefWidth="175.0" style="-fx-background-color: #4A7C59; -fx-background-radius: 8px; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;" text="Adicionar à Prova" />
                    </children>
                </HBox>
            </children>
        </VBox>
    </center>
</BorderPane>