<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="650.0" prefWidth="980.0" styleClass="fundo-inicio" stylesheets="@../estilo.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.controllers.profControllers.FormEditorController">
   <left>
      <fx:include source="BarraLateralProf.fxml" />
   </left>
   <center>
      <VBox spacing="14.0" BorderPane.alignment="CENTER">
         <padding>
            <Insets bottom="18.0" left="24.0" right="24.0" top="18.0" />
         </padding>
         <children>
            <!-- Cabeçalho no padrão das telas de correção e pré-visualização -->
            <HBox alignment="CENTER_LEFT" spacing="16.0" style="-fx-background-color: rgba(255, 255, 255, 0.96); -fx-background-radius: 12px; -fx-border-color: #D4DFD8; -fx-border-radius: 12px; -fx-border-width: 1px; -fx-padding: 16 20 16 20;">
               <children>
                  <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                     <children>
                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                           <children>
                              <Label style="-fx-background-color: #DDEEE2; -fx-text-fill: #285A36; -fx-font-weight: bold; -fx-font-size: 11px; -fx-padding: 3 10 3 10; -fx-background-radius: 10px;" text="MONTAGEM DA PROVA" />
                              <Label fx:id="lbl_disciplina_editor" text="" textFill="#5F6368">
                                 <font>
                                    <Font name="System Bold" size="12.0" />
                                 </font>
                              </Label>
                           </children>
                        </HBox>
                        <Label fx:id="lbl_titulo_editor" text="Criar Formulário" textFill="#1B1B1B" wrapText="true">
                           <font>
                              <Font name="System Bold" size="22.0" />
                           </font>
                        </Label>
                        <Label fx:id="lbl_info_editor" text="Adicione questões de múltipla escolha, checklist, dissertativas ou correspondência." textFill="#5F6368" wrapText="true">
                           <font>
                              <Font size="13.0" />
                           </font>
                        </Label>
                     </children>
                  </VBox>

                  <VBox alignment="CENTER_RIGHT" spacing="4.0" style="-fx-background-color: #EEF5F0; -fx-background-radius: 10px; -fx-border-color: #C4D6CA; -fx-border-radius: 10px; -fx-padding: 10 16 10 16;">
                     <children>
                        <Label fx:id="lbl_resumo_questoes_editor" text="0 questões" textFill="#285A36">
                           <font>
                              <Font name="System Bold" size="13.0" />
                           </font>
                        </Label>
                        <Label fx:id="lbl_resumo_pontos_editor" text="Total: 0,00 pts" textFill="#4A7C59">
                           <font>
                              <Font name="System Bold" size="12.0" />
                           </font>
                        </Label>
                     </children>
                  </VBox>
               </children>
            </HBox>

            <!-- Área rolável com os cards dinâmicos das questões -->
            <ScrollPane fitToWidth="true" hbarPolicy="NEVER" style="-fx-background-color: transparent; -fx-background: transparent; -fx-border-color: transparent;" VBox.vgrow="ALWAYS">
               <content>
                  <VBox fx:id="container_dinamico" alignment="TOP_LEFT" spacing="14.0">
                     <padding>
                        <Insets bottom="8.0" left="2.0" right="6.0" top="2.0" />
                     </padding>
                  </VBox>
               </content>
            </ScrollPane>

            <!-- Rodapé fixo com ações principais -->
            <HBox alignment="CENTER_LEFT" spacing="12.0" style="-fx-background-color: rgba(255, 255, 255, 0.96); -fx-background-radius: 12px; -fx-border-color: #D4DFD8; -fx-border-radius: 12px; -fx-border-width: 1px; -fx-padding: 12 20 12 20;">
               <children>
                  <Button fx:id="btn_adicionar" mnemonicParsing="false" onAction="#adicionarQuestao" prefHeight="38.0" prefWidth="170.0" style="-fx-background-color: #EEF5F0; -fx-border-color: #C4D6CA; -fx-border-radius: 8px; -fx-background-radius: 8px; -fx-text-fill: #285A36; -fx-font-weight: bold; -fx-cursor: hand;" text="+ Adicionar Questão">
                     <font>
                        <Font size="13.0" />
                     </font>
                  </Button>
                  <Button fx:id="btn_banco_questoes" mnemonicParsing="false" onAction="#entraa_banco_questoes" prefHeight="38.0" prefWidth="175.0" style="-fx-background-color: #FFFFFF; -fx-border-color: #4A7C59; -fx-border-radius: 8px; -fx-background-radius: 8px; -fx-text-fill: #285A36; -fx-font-weight: bold; -fx-cursor: hand;" text="Banco de Questões">
                     <font>
                        <Font size="13.0" />
                     </font>
                  </Button>
                  <Region HBox.hgrow="ALWAYS" />
                  <Button fx:id="btn_cancelar_form" mnemonicParsing="false" onAction="#cancelaFormulario" prefHeight="38.0" prefWidth="130.0" style="-fx-background-color: #FCE8E6; -fx-border-color: #F2B8B5; -fx-border-radius: 8px; -fx-background-radius: 8px; -fx-text-fill: #B3261E; -fx-font-weight: bold; -fx-cursor: hand;" text="Cancelar">
                     <font>
                        <Font size="13.0" />
                     </font>
                  </Button>
                  <Button fx:id="btn_finalizar" mnemonicParsing="false" onAction="#GeraProva" prefHeight="38.0" prefWidth="165.0" style="-fx-background-color: #4A7C59; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8px; -fx-cursor: hand;" text="Finalizar Prova">
                     <font>
                        <Font size="13.0" />
                     </font>
                  </Button>
               </children>
            </HBox>
         </children>
      </VBox>
   </center>
</BorderPane>
