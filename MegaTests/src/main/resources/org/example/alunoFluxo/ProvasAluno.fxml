<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="600.0" prefWidth="960.0" styleClass="fundo-inicio" stylesheets="@../estilo.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.controllers.alunoControllers.ProvasAlunoController">
   <left>
      <VBox fx:id="barra_lateral" alignment="CENTER_LEFT" minHeight="200.0" minWidth="60.0" onMouseEntered="#expande_barra" onMouseExited="#minimiza_barra" prefHeight="600.0" prefWidth="60.0" style="-fx-background-color: #0066ff;" styleClass="barralateral" BorderPane.alignment="CENTER">
         <children>

            <Button fx:id="menu_meucurso" alignment="BASELINE_LEFT" graphicTextGap="15.0" mnemonicParsing="false" onAction="#entra_meucurso" prefHeight="48.0" prefWidth="200.0" style="-fx-background-color: #0066ff; -fx-padding: 0 0 0 10;" text="Meu Curso" textFill="WHITE">
               <VBox.margin>
                  <Insets bottom="25.0" top="30.0" />
               </VBox.margin>
               <graphic>
                  <ImageView fitHeight="40.0" fitWidth="40.0" pickOnBounds="true" preserveRatio="true">
                     <image>
                        <Image url="@../Imagens/turma.png" />
                     </image>
                  </ImageView>
               </graphic>
               <font>
                  <Font name="System Bold" size="12.0" />
               </font>
            </Button>

            <Button fx:id="minhas_provas_aluno" alignment="BASELINE_LEFT" graphicTextGap="15.0" mnemonicParsing="false" onAction="#entra_menuprova_aluno" prefHeight="48.0" prefWidth="200.0" style="-fx-background-color: #0066ff; -fx-padding: 0 0 0 10;" text="Ver Provas" textFill="WHITE">
               <VBox.margin>
                  <Insets bottom="25.0" top="30.0" />
               </VBox.margin>
               <graphic>
                  <ImageView fitHeight="40.0" fitWidth="40.0" pickOnBounds="true" preserveRatio="true">
                     <image>
                        <Image url="@../Imagens/prova.png" />
                     </image>
                  </ImageView>
               </graphic>
               <font>
                  <Font name="System Bold" size="12.0" />
               </font>
            </Button>

            <Button fx:id="dados_pessoais_alu" alignment="BASELINE_LEFT" graphicTextGap="15.0" mnemonicParsing="false" onAction="#entra_dados_pessoais_alu" prefHeight="48.0" prefWidth="200.0" style="-fx-background-color: #0066ff; -fx-padding: 0 0 0 10;" text="Dados Pessoais" textFill="WHITE">
               <VBox.margin>
                  <Insets bottom="25.0" top="30.0" />
               </VBox.margin>
               <graphic>
                  <ImageView fitHeight="40.0" fitWidth="40.0" pickOnBounds="true" preserveRatio="true">
                     <image>
                        <Image url="@../Imagens/dados.png" />
                     </image>
                  </ImageView>
               </graphic>
               <font>
                  <Font name="System Bold" size="12.0" />
               </font>
            </Button>

            <Button fx:id="menu_sair_aluno" alignment="BASELINE_LEFT" graphicTextGap="15.0" mnemonicParsing="false" onAction="#deslogar_aluno" prefHeight="48.0" prefWidth="200.0" style="-fx-background-color: #0066ff; -fx-padding: 0 0 0 10;" text="Sair" textFill="WHITE">
               <VBox.margin>
                  <Insets bottom="25.0" left="5.0" top="30.0" />
               </VBox.margin>
               <graphic>
                  <ImageView fitHeight="42.0" fitWidth="39.0" pickOnBounds="true" preserveRatio="true">
                     <image>
                        <Image url="@../Imagens/aa.png" />
                     </image>
                  </ImageView>
               </graphic>
               <font>
                  <Font name="System Bold" size="12.0" />
               </font>
            </Button>

         </children>
      </VBox>
   </left>
   <center>
      <VBox prefHeight="600.0" prefWidth="880.0" spacing="0.0" BorderPane.alignment="CENTER">
         <children>
            <!-- Cabeçalho superior padronizado com MeuCursoAluno -->
            <HBox alignment="CENTER_LEFT" spacing="16.0" style="-fx-background-color: rgba(255, 255, 255, 0.90); -fx-border-color: #DCE3EC; -fx-border-width: 0 0 1 0;">
               <padding>
                  <Insets bottom="18.0" left="28.0" right="28.0" top="18.0" />
               </padding>
               <children>
                  <VBox spacing="4.0">
                     <children>
                        <Label text="AVALIAÇÕES EM ABERTO" textFill="#0066FF">
                           <font>
                              <Font name="System Bold" size="11.0" />
                           </font>
                        </Label>
                        <Label text="Provas Pendentes" textFill="#1B1B1B">
                           <font>
                              <Font name="System Bold" size="22.0" />
                           </font>
                        </Label>
                        <Label fx:id="lbl_resumo_pendentes" text="Carregando provas disponíveis..." textFill="#5F6368" wrapText="true">
                           <font>
                              <Font size="13.0" />
                           </font>
                        </Label>
                     </children>
                  </VBox>
                  <Region HBox.hgrow="ALWAYS" />
                  <Button mnemonicParsing="false" onAction="#VoltarInicio_aluno" prefHeight="38.0" prefWidth="115.0" style="-fx-background-color: #F1F4F8; -fx-border-color: #C4CEDB; -fx-border-radius: 8px; -fx-background-radius: 8px; -fx-text-fill: #2B3340; -fx-font-weight: bold; -fx-cursor: hand;" text="Voltar" />
               </children>
            </HBox>

            <!-- Área rolável com os cards agrupados por matéria -->
            <ScrollPane fitToWidth="true" hbarPolicy="NEVER" style="-fx-background-color: transparent; -fx-background: transparent; -fx-border-color: transparent;" VBox.vgrow="ALWAYS">
               <content>
                  <VBox fx:id="vb_provacontainer_aluno" fillWidth="true" spacing="18.0">
                     <padding>
                        <Insets bottom="26.0" left="28.0" right="28.0" top="22.0" />
                     </padding>
                  </VBox>
               </content>
            </ScrollPane>
         </children>
      </VBox>
   </center>
</BorderPane>