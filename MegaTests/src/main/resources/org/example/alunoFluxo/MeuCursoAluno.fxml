<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="620.0" prefWidth="920.0" styleClass="fundo-inicio" stylesheets="@../estilo.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.controllers.alunoControllers.MeuCursoAlunoController">

    <left>
        <VBox fx:id="barra_lateral" alignment="CENTER_LEFT" minHeight="200.0" minWidth="60.0" onMouseEntered="#expande_barra" onMouseExited="#minimiza_barra" prefHeight="400.0" prefWidth="60.0" style="-fx-background-color: #0066ff;" styleClass="barralateral" BorderPane.alignment="CENTER">
            <children>

                <Button fx:id="menu_meucurso" alignment="BASELINE_LEFT" graphicTextGap="15.0" mnemonicParsing="false" onAction="#entra_meucurso" prefHeight="48.0" prefWidth="200.0" style="-fx-background-color: #0052cc; -fx-padding: 0 0 0 10;" text="Ver Curso" textFill="WHITE">
                    <VBox.margin>
                        <Insets bottom="25.0" top="30.0" />
                    </VBox.margin>
                    <graphic>
                        <ImageView fitHeight="40.0" fitWidth="40.0" pickOnBounds="true" preserveRatio="true">
                            <image>
                                <Image url="@../Imagens/turma.png" />
                            </image>
                        </ImageView>
                    </graphic>
                    <font>
                        <Font name="System Bold" size="12.0" />
                    </font>
                </Button>

                <Button fx:id="minhas_provas_aluno" alignment="BASELINE_LEFT" graphicTextGap="15.0" mnemonicParsing="false" onAction="#entra_menuprova_aluno" prefHeight="48.0" prefWidth="200.0" style="-fx-background-color: #0066ff; -fx-padding: 0 0 0 10;" text="Ver Provas" textFill="WHITE">
                    <VBox.margin>
                        <Insets bottom="25.0" top="30.0" />
                    </VBox.margin>
                    <graphic>
                        <ImageView fitHeight="40.0" fitWidth="40.0" pickOnBounds="true" preserveRatio="true">
                            <image>
                                <Image url="@../Imagens/prova.png" />
                            </image>
                        </ImageView>
                    </graphic>
                    <font>
                        <Font name="System Bold" size="12.0" />
                    </font>
                </Button>

                <Button fx:id="dados_pessoais_alu" alignment="BASELINE_LEFT" graphicTextGap="15.0" mnemonicParsing="false" onAction="#entra_dados_pessoais_alu" prefHeight="48.0" prefWidth="200.0" style="-fx-background-color: #0066ff; -fx-padding: 0 0 0 10;" text="Dados Pessoais" textFill="WHITE">
                    <VBox.margin>
                        <Insets bottom="25.0" top="30.0" />
                    </VBox.margin>
                    <graphic>
                        <ImageView fitHeight="40.0" fitWidth="40.0" pickOnBounds="true" preserveRatio="true">
                            <image>
                                <Image url="@../Imagens/dados.png" />
                            </image>
                        </ImageView>
                    </graphic>
                    <font>
                        <Font name="System Bold" size="12.0" />
                    </font>
                </Button>

                <Button fx:id="menu_sair_aluno" alignment="BASELINE_LEFT" graphicTextGap="15.0" mnemonicParsing="false" onAction="#deslogar_aluno" prefHeight="48.0" prefWidth="200.0" style="-fx-background-color: #0066ff; -fx-padding: 0 0 0 10;" text="Sair" textFill="WHITE">
                    <VBox.margin>
                        <Insets bottom="25.0" left="5.0" top="30.0" />
                    </VBox.margin>
                    <graphic>
                        <ImageView fitHeight="42.0" fitWidth="39.0" pickOnBounds="true" preserveRatio="true">
                            <image>
                                <Image url="@../Imagens/aa.png" />
                            </image>
                        </ImageView>
                    </graphic>
                    <font>
                        <Font name="System Bold" size="12.0" />
                    </font>
                </Button>

            </children>
        </VBox>
    </left>

    <center>
        <BorderPane>
            <top>
                <VBox spacing="6.0" style="-fx-background-color: rgba(255,255,255,0.95); -fx-border-color: transparent transparent #dce1e7 transparent;">
                    <padding>
                        <Insets bottom="16.0" left="24.0" right="24.0" top="18.0" />
                    </padding>
                    <HBox alignment="CENTER_LEFT" spacing="12.0">
                        <VBox spacing="4.0">
                            <Label style="-fx-text-fill: #687386; -fx-font-size: 12px; -fx-font-weight: bold;" text="MEU CURSO" />
                            <Label fx:id="lblNomeCurso" style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #1B1B1B;" text="Carregando curso..." />
                            <Label fx:id="lblResumoCurso" style="-fx-font-size: 13px; -fx-text-fill: #555555;" text="Matérias e provas corrigidas" />
                        </VBox>
                        <Region HBox.hgrow="ALWAYS" />
                        <Button mnemonicParsing="false" onAction="#voltarInicio" prefHeight="36.0" prefWidth="110.0" style="-fx-background-radius: 8px; -fx-cursor: hand;" text="Voltar" />
                    </HBox>
                </VBox>
            </top>

            <center>
                <ScrollPane fitToWidth="true" hbarPolicy="NEVER" style="-fx-background: transparent; -fx-background-color: transparent;">
                    <content>
                        <VBox fx:id="vboxMaterias" fillWidth="true" spacing="16.0">
                            <padding>
                                <Insets bottom="22.0" left="24.0" right="24.0" top="20.0" />
                            </padding>
                        </VBox>
                    </content>
                </ScrollPane>
            </center>
        </BorderPane>
    </center>

</BorderPane>