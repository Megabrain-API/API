<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="650.0" prefWidth="960.0" styleClass="fundo-inicio" stylesheets="@../estilo.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.controllers.alunoControllers.ProvaCorrigidaAlunoController">

    <left>
        <VBox fx:id="barra_lateral" alignment="CENTER_LEFT" minHeight="200.0" minWidth="60.0" onMouseEntered="#expande_barra" onMouseExited="#minimiza_barra" prefHeight="400.0" prefWidth="60.0" style="-fx-background-color: #0066ff;" styleClass="barralateral" BorderPane.alignment="CENTER">
            <children>

                <Button fx:id="menu_meucurso" alignment="BASELINE_LEFT" graphicTextGap="15.0" mnemonicParsing="false" onAction="#entra_meucurso" prefHeight="48.0" prefWidth="200.0" style="-fx-background-color: #0052cc; -fx-padding: 0 0 0 10;" text="Ver Curso" textFill="WHITE">
                    <VBox.margin>
                        <Insets bottom="25.0" top="30.0" />
                    </VBox.margin>
                    <graphic>
                        <ImageView fitHeight="40.0" fitWidth="40.0" pickOnBounds="true" preserveRatio="true">
                            <image>
                                <Image url="@../Imagens/turma.png" />
                            </image>
                        </ImageView>
                    </graphic>
                    <font>
                        <Font name="System Bold" size="12.0" />
                    </font>
                </Button>

                <Button fx:id="minhas_provas_aluno" alignment="BASELINE_LEFT" graphicTextGap="15.0" mnemonicParsing="false" onAction="#entra_menuprova_aluno" prefHeight="48.0" prefWidth="200.0" style="-fx-background-color: #0066ff; -fx-padding: 0 0 0 10;" text="Ver Provas" textFill="WHITE">
                    <VBox.margin>
                        <Insets bottom="25.0" top="30.0" />
                    </VBox.margin>
                    <graphic>
                        <ImageView fitHeight="40.0" fitWidth="40.0" pickOnBounds="true" preserveRatio="true">
                            <image>
                                <Image url="@../Imagens/prova.png" />
                            </image>
                        </ImageView>
                    </graphic>
                    <font>
                        <Font name="System Bold" size="12.0" />
                    </font>
                </Button>

                <Button fx:id="dados_pessoais_alu" alignment="BASELINE_LEFT" graphicTextGap="15.0" mnemonicParsing="false" onAction="#entra_dados_pessoais_alu" prefHeight="48.0" prefWidth="200.0" style="-fx-background-color: #0066ff; -fx-padding: 0 0 0 10;" text="Dados Pessoais" textFill="WHITE">
                    <VBox.margin>
                        <Insets bottom="25.0" top="30.0" />
                    </VBox.margin>
                    <graphic>
                        <ImageView fitHeight="40.0" fitWidth="40.0" pickOnBounds="true" preserveRatio="true">
                            <image>
                                <Image url="@../Imagens/dados.png" />
                            </image>
                        </ImageView>
                    </graphic>
                    <font>
                        <Font name="System Bold" size="12.0" />
                    </font>
                </Button>

                <Button fx:id="menu_sair_aluno" alignment="BASELINE_LEFT" graphicTextGap="15.0" mnemonicParsing="false" onAction="#deslogar_aluno" prefHeight="48.0" prefWidth="200.0" style="-fx-background-color: #0066ff; -fx-padding: 0 0 0 10;" text="Sair" textFill="WHITE">
                    <VBox.margin>
                        <Insets bottom="25.0" left="5.0" top="30.0" />
                    </VBox.margin>
                    <graphic>
                        <ImageView fitHeight="42.0" fitWidth="39.0" pickOnBounds="true" preserveRatio="true">
                            <image>
                                <Image url="@../Imagens/aa.png" />
                            </image>
                        </ImageView>
                    </graphic>
                    <font>
                        <Font name="System Bold" size="12.0" />
                    </font>
                </Button>

            </children>
        </VBox>
    </left>

    <center>
        <BorderPane>
            <top>
                <VBox spacing="8.0" style="-fx-background-color: rgba(255,255,255,0.95); -fx-border-color: transparent transparent #dce1e7 transparent;">
                    <padding>
                        <Insets bottom="14.0" left="24.0" right="24.0" top="16.0" />
                    </padding>

                    <Label style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #1B1B1B;" text="Resultado da Prova Corrigida" />

                    <HBox alignment="CENTER_LEFT" spacing="24.0">
                        <VBox spacing="2.0">
                            <Label style="-fx-text-fill: #687386; -fx-font-size: 11px;" text="Prova" />
                            <Label fx:id="lblNomeProva" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #1B1B1B;" text="Nome da prova" />
                        </VBox>

                        <VBox spacing="2.0">
                            <Label style="-fx-text-fill: #687386; -fx-font-size: 11px;" text="Matéria" />
                            <Label fx:id="lblDisciplina" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #0066ff;" text="Disciplina" />
                        </VBox>

                        <VBox spacing="2.0">
                            <Label style="-fx-text-fill: #687386; -fx-font-size: 11px;" text="Curso" />
                            <Label fx:id="lblCurso" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #1B1B1B;" text="Curso" />
                        </VBox>
                    </HBox>
                </VBox>
            </top>

            <center>
                <ScrollPane fitToWidth="true" hbarPolicy="NEVER" style="-fx-background: transparent; -fx-background-color: transparent;">
                    <content>
                        <VBox fx:id="vboxQuestoes" fillWidth="true" spacing="14.0">
                            <padding>
                                <Insets bottom="20.0" left="24.0" right="24.0" top="20.0" />
                            </padding>
                        </VBox>
                    </content>
                </ScrollPane>
            </center>

            <bottom>
                <VBox style="-fx-background-color: rgba(255,255,255,0.96); -fx-border-color: #dce1e7 transparent transparent transparent;">
                    <padding>
                        <Insets bottom="14.0" left="24.0" right="24.0" top="14.0" />
                    </padding>

                    <HBox alignment="CENTER_LEFT" spacing="16.0">
                        <Label fx:id="lblNotaFinal" style="-fx-font-weight: bold; -fx-font-size: 15px; -fx-text-fill: #285A36; -fx-background-color: #DDEEE2; -fx-background-radius: 6px; -fx-padding: 6px 14px;" text="Nota final: 0,00 / 0,00" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Button mnemonicParsing="false" onAction="#voltarAoCurso" prefHeight="38.0" prefWidth="170.0" style="-fx-background-color: #0066ff; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8px; -fx-cursor: hand;" text="Voltar ao Curso" />
                    </HBox>
                </VBox>
            </bottom>
        </BorderPane>
    </center>

</BorderPane>