<BorderPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.controllers.alunoControllers.MenuAlunoController">
   <center>
      <StackPane styleClass="fundo-inicio" stylesheets="@../../../../../../../../../../../estilo.css" BorderPane.alignment="CENTER">
         <children>
            <VBox alignment="CENTER" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="0.0" minWidth="0.0" prefHeight="34.0" prefWidth="600.0" style="-fx-background-radius: 15; -fx-padding: 25;" StackPane.alignment="CENTER">
               <children>
                  <MenuBar maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="34.0" prefWidth="600.0" style="-fx-background-color: #0066ff;" stylesheets="@../estilo.css">
                    <menus>
                      <Menu mnemonicParsing="false" style="-fx-text-fill: #E0E0E0;" text="Meu Curso">
                        <items>
                          <MenuItem fx:id="menu_meucurso" mnemonicParsing="false" onAction="#entra_meucurso" style="-fx-text-fill: #000000;" text="Ver Curso" />
                        </items>
                           <graphic>
                              <Region prefHeight="115.0" prefWidth="0.0" />
                           </graphic>
                      </Menu>
                      <Menu mnemonicParsing="false" text="Minhas Provas">
                        <items>
                          <MenuItem fx:id="minhas_provas_aluno" mnemonicParsing="false" onAction="#entra_menuprova_aluno" style="-fx-text-fill: #000000;" text="Ver Provas" />
