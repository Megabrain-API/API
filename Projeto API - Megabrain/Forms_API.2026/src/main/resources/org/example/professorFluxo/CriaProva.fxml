<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="400.0" prefWidth="600.0" styleClass="fundo-inicio" stylesheets="@../estilo.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.controllers.profControllers.CriaProvaController">
   <left>
      <fx:include source="BarraLateralProf.fxml" />
   </left>
   <center>
      <StackPane>
         <children>
            <VBox maxHeight="-Infinity" maxWidth="-Infinity" minHeight="0.0" minWidth="0.0" prefHeight="370.0" prefWidth="542.0" spacing="5.0" StackPane.alignment="CENTER">
               <children>
                    <Label maxHeight="-Infinity" maxWidth="-Infinity" prefHeight="35.0" prefWidth="146.0" text="Criar prova">
                        <font>
                            <Font name="System Bold" size="24.0" />
                        </font>
                     <VBox.margin>
                        <Insets bottom="15.0" />
                     </VBox.margin>
                    </Label>
                    <Label maxHeight="-Infinity" maxWidth="-Infinity" prefHeight="30.0" prefWidth="118.0" text="Nome da prova">
                        <font>
                            <Font name="System Bold" size="16.0" />
                        </font>
                    </Label>
                    <TextField fx:id="nomeProva" maxHeight="-Infinity" maxWidth="-Infinity" prefHeight="50.0" prefWidth="542.0" promptText="Ex: Prova 1 - Cálculo" />
                    <Label maxHeight="-Infinity" maxWidth="-Infinity" prefHeight="30.0" prefWidth="118.0" text="Disciplina">
                        <font>
                            <Font name="System Bold" size="16.0" />
                        </font>
                    </Label>
                    <ComboBox fx:id="selectDisciplina" maxHeight="-Infinity" maxWidth="-Infinity" opacity="0.85" prefHeight="50.0" prefWidth="542.0" promptText="Selecione a disciplina" />
                    <Label maxHeight="-Infinity" maxWidth="-Infinity" prefHeight="26.0" prefWidth="144.0" text="Tipo de questões ">
                        <font>
                            <Font name="System Bold" size="16.0" />
                        </font>
                    </Label>
                    <ComboBox fx:id="selectQuestoes" maxHeight="-Infinity" maxWidth="-Infinity" opacity="0.85" prefHeight="50.0" prefWidth="542.0" promptText="Selecione o tipo das questões" />
                    <Label maxHeight="-Infinity" maxWidth="-Infinity" prefHeight="30.0" prefWidth="204.0" text="Insira o prazo de entrega">
                        <font>
                            <Font name="System Bold" size="16.0" />
                        </font>
                    </Label>
                    <TextField fx:id="prazoEntrega" maxHeight="-Infinity" maxWidth="-Infinity" prefHeight="50.0" prefWidth="542.0" promptText="Ex: 23/05/2026" />
                  <HBox prefHeight="100.0" prefWidth="200.0" spacing="200.0">
                     <children>
                        <Button fx:id="voltarCriaProva" maxHeight="-Infinity" maxWidth="-Infinity" mnemonicParsing="false" onAction="#voltar_criaProva" prefHeight="40.0" prefWidth="177.0" style="-fx-background-radius: 8px;" text="Voltar" textAlignment="CENTER">
                           <font>
                              <Font name="System Bold" size="15.0" />
                           </font>
                        </Button>
                          <Button fx:id="confirmCriarProva" maxHeight="-Infinity" maxWidth="-Infinity" mnemonicParsing="false" onAction="#confirmCriarProva" prefHeight="40.0" prefWidth="166.0" style="-fx-background-color: #4A7C59; -fx-background-radius: 8px;" text="Confirmar" textAlignment="CENTER" textFill="WHITE">
                              <font>
                                  <Font name="System Bold" size="15.0" />
                              </font>
                          </Button>
                     </children>
                     <VBox.margin>
                        <Insets top="20.0" />
                     </VBox.margin>
                  </HBox>
               </children>
            </VBox>
         </children>
      </StackPane>
   </center>
</BorderPane>
