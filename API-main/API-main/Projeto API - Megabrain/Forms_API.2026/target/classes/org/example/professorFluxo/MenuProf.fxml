         <children>
            <VBox alignment="CENTER" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="0.0" minWidth="0.0" prefHeight="34.0" prefWidth="600.0" style="-fx-background-radius: 15; -fx-padding: 25;" StackPane.alignment="CENTER">
               <children>
                  <MenuBar maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="34.0" prefWidth="600.0" style="-fx-background-color: #00674F;" stylesheets="@../estilo.css">
                    <menus>
                      <Menu mnemonicParsing="false" style="-fx-text-fill: #E0E0E0;" text="Minhas Turmas">
                        <items>
                          <MenuItem fx:id="menu_minhaturma" mnemonicParsing="false" onAction="#entra_minhaturma" style="-fx-text-fill: #000000;" text="Ver Turmas" />
                        </items>
                           <graphic>
                              <Region prefHeight="115.0" prefWidth="0.0" />
                           </graphic>
                      </Menu>
                      <Menu mnemonicParsing="false" text="Minhas Provas">
